runs/
wandb/
tensorboard/
*.out

# Keep YOLOv5's required W&B compatibility source while ignoring run artifacts.
!resources/EDTC/yolov5/utils/loggers/wandb/
resources/EDTC/yolov5/utils/loggers/wandb/*
!resources/EDTC/yolov5/utils/loggers/wandb/__init__.py
!resources/EDTC/yolov5/utils/loggers/wandb/wandb_utils.py

# Keep the inherited YOLOv5 training hyperparameters while ignoring datasets.
!resources/EDTC/yolov5/data/
resources/EDTC/yolov5/data/*
!resources/EDTC/yolov5/data/hyps/
resources/EDTC/yolov5/data/hyps/*
!resources/EDTC/yolov5/data/hyps/hyp.scratch-low.yaml

# Private experiment planning (local working document)
/experiments/OVERVIEW.md

# Generated thesis artifacts
# The thesis manuscript is private and remains local only.
thesis/
thesis/**/*.aux
thesis/**/*.bbl
thesis/**/*.bcf
thesis/**/*.blg
thesis/**/*.fdb_latexmk
thesis/**/*.fls
thesis/**/*.log
thesis/**/*.out
thesis/**/*.pdf
thesis/**/*.run.xml
thesis/**/*.synctex.gz
thesis/**/*.toc
