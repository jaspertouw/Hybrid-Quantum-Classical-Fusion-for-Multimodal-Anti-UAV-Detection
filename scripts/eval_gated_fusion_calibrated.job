#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=gated_calibrated
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=04:00:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/gated_calibrated_%A.out

# Gated Fusion — calibrated threshold confirmation run.
#
# Prerequisite: train_gate.job + eval_gated_fusion.job (default thresholds)
# + calibrate_gated_fusion.job (Pass 1 + Pass 2).
# Set the four THETA_* values below from top10_candidates.json.
#
# Typical workflow:
#   1. sbatch scripts/train_gate.job
#   2. sbatch scripts/eval_gated_fusion.job          (default thresholds → logs)
#   3. sbatch scripts/calibrate_gated_fusion.job     (offline sweep Pass 1)
#   4. Re-run calibrate_gated_fusion.job with TRACK sweep (Pass 2)
#   5. Set THETA_* below and sbatch this script.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
GATE=$PRETRAINED/gated_fusion/gate_best.pth

# ── Thresholds to confirm ─────────────────────────────────────────────────
# Edit these four values with the best candidate from top10_candidates.json.
THETA_CLS_DETECT=0.80
THETA_LOC_DETECT=0.10
THETA_CLS_TRACK=0.90
THETA_LOC_TRACK=0.70
# ──────────────────────────────────────────────────────────────────────────

TAG="cd${THETA_CLS_DETECT}_ld${THETA_LOC_DETECT}_ct${THETA_CLS_TRACK}_lt${THETA_LOC_TRACK}"
RESULTS=$PRETRAINED/gated_fusion/val_results_calibrated_${TAG}

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH

mkdir -p $RESULTS
mkdir -p $REPO/logs

cd $REPO

srun python -u -m src.edtc_fusion.run_gated_fusion \
    --gate_weights        $GATE \
    --dataset_root        $DATA/val \
    --results_dir         $RESULTS \
    --yolo_ir             $PRETRAINED/evidential/evidential_ir_stage2_best.pt \
    --yolo_rgb            $PRETRAINED/evidential/evidential_rgb_stage2_best.pt \
    --yolo_ir_base        $PRETRAINED/best_clean.pt \
    --yolo_rgb_base       $PRETRAINED/best_clean_rgb.pt \
    --siam_ir_stage2      $PRETRAINED/siamcar_gaussian/siamcar_ir_stage2_best.pth \
    --siam_rgb_stage2     $PRETRAINED/siamcar_gaussian/siamcar_rgb_stage2_best.pth \
    --siam_ir_stage1      $PRETRAINED/siamcar_gaussian/siamcar_ir_stage1g_best.pth \
    --siam_rgb_stage1     $PRETRAINED/siamcar_gaussian/siamcar_rgb_stage1g_best.pth \
    --siam_ir_pretrained  $PRETRAINED/siamcar_thermal_final.pth \
    --siam_rgb_pretrained $PRETRAINED/siamcar_rgb_final.pth \
    --siam_ir_cfg         $REPO/resources/SiamCAR/experiments/siamcar_r50/config_antiuav_thermal.yaml \
    --siam_rgb_cfg        $REPO/resources/SiamCAR/experiments/siamcar_r50/config_antiuav_rgb.yaml \
    --theta_cls_detect    $THETA_CLS_DETECT \
    --theta_loc_detect    $THETA_LOC_DETECT \
    --theta_cls_track     $THETA_CLS_TRACK \
    --theta_loc_track     $THETA_LOC_TRACK

echo ""
echo "Gated Fusion calibrated run complete."
echo "Thresholds : cls_d=${THETA_CLS_DETECT}  loc_d=${THETA_LOC_DETECT}  cls_t=${THETA_CLS_TRACK}  loc_t=${THETA_LOC_TRACK}"
echo "Results    : $RESULTS/summary.json"
echo "Acc metric : failure_iou_thresh=1e-5  penalty_denom=T_total (not T*)  [matches EDTC eval script]"
