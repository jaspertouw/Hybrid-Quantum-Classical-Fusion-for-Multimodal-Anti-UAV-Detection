#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=00:30:00
#SBATCH --job-name=calib_detonly_dbf
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/calib_detonly_dbf_%A.out

# EXACT offline sweep of the detector-only uncertainty threshold (theta_cls)
# for the DBF variant.  No GPU inference — replays the gate over logged values.
#
# Prerequisite: eval_detector_only_dbf.job must have produced *_log.csv (with
# the b_bg / dms_box columns) in $LOG_DIR.
#
# Grid: theta_cls = 0.05 .. 0.95 (step 0.05), same as the original EDTC sweep.
# After this completes, re-run TEST with --theta_cls <best> from theta_sweep.json.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
LOG_DIR=$PRETRAINED/edtc_fusion/val_results_detector_only_dbf_peak
OUT_DIR=$PRETRAINED/edtc_fusion/calibration_detonly_dbf_peak

mkdir -p $OUT_DIR
mkdir -p $REPO/logs

cd $REPO

python scripts/calibrate_detonly_threshold.py \
    --log_dir      $LOG_DIR \
    --dataset_root $DATA/val \
    --out_dir      $OUT_DIR \
    --top_k        10

echo ""
echo "DBF det-only theta_cls sweep complete.  Best -> $OUT_DIR/theta_sweep.json"
