#!/bin/bash
#SBATCH --account=gisr139746
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=train_gaussian_heads
#SBATCH --array=0-1%1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=30:00:00
#SBATCH --output=/projects/prjs2348/mm-uav-threat-detection/logs/%x_%A_%a.out

set -euo pipefail

readonly REPO="${HOME}/mm-uav-threat-detection"
readonly ENV_PREFIX="${HOME}/.conda/envs/thesis-detector"
readonly PROJECT_ROOT="/projects/prjs2348/mm-uav-threat-detection"
readonly DATA_ROOT="${PROJECT_ROOT}/data/Anti-UAV-RGBT"
readonly DERIVED_ROOT="${PROJECT_ROOT}/data/derived/yolo_inherited_v1"
readonly CLEAN_ROOT="${PROJECT_ROOT}/checkpoints/detectors/clean_yolo"
readonly OUTPUT_ROOT="${PROJECT_ROOT}/checkpoints/detectors/evidential"
readonly MODALITIES=(thermal rgb)
readonly MODALITY="${MODALITIES[${SLURM_ARRAY_TASK_ID}]}"
readonly CLEAN_WEIGHT="${CLEAN_ROOT}/${MODALITY}_seed0/weights/best.pt"
readonly NAME="${MODALITY}_stage1g_seed0"

test -d "${REPO}/.git"
test -x "${ENV_PREFIX}/bin/python"
test -f "${CLEAN_WEIGHT}"
test -f "${DERIVED_ROOT}/${MODALITY}/dataset.yaml"
test -f "${DERIVED_ROOT}/${MODALITY}/train_images.txt"
test -f "${DERIVED_ROOT}/${MODALITY}/val_images.txt"
test ! -e "${DATA_ROOT}/test"
mkdir -p "${OUTPUT_ROOT}"

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${ENV_PREFIX}"

export PYTHONPATH="${REPO}/resources/EDTC:${REPO}/resources/EDTC/yolov5:${PYTHONPATH:-}"
cd "${REPO}/resources/EDTC"

echo "Job: ${SLURM_JOB_ID} task ${SLURM_ARRAY_TASK_ID} on $(hostname)"
echo "Repository: ${REPO} ($(git -C "${REPO}" rev-parse HEAD))"
echo "Modality: ${MODALITY}; seed: 0"
sha256sum "${CLEAN_WEIGHT}"
nvidia-smi

srun python -u lib/models/yolo_evidential/train_stage1_gaussian.py \
    --weights "${CLEAN_WEIGHT}" \
    --data "${DERIVED_ROOT}/${MODALITY}/dataset.yaml" \
    --train_txt "${DERIVED_ROOT}/${MODALITY}/train_images.txt" \
    --val_txt "${DERIVED_ROOT}/${MODALITY}/val_images.txt" \
    --save_dir "${OUTPUT_ROOT}" \
    --name "${NAME}" \
    --device 0 \
    --epochs 30 \
    --warmup_epochs 5 \
    --batch_size 64 \
    --workers 8 \
    --lr_phase_a 1e-3 \
    --lr_phase_b 1e-4 \
    --lambda_var 0.1 \
    --K 2 \
    --conf_thres 0.25 \
    --iou_thres 0.45 \
    --seed 0 \
    --resume

test -f "${OUTPUT_ROOT}/${NAME}_last.pt"
sha256sum "${OUTPUT_ROOT}/${NAME}_last.pt"
if [[ -f "${OUTPUT_ROOT}/${NAME}_best.pt" ]]; then
    sha256sum "${OUTPUT_ROOT}/${NAME}_best.pt"
fi
echo "GAUSSIAN HEAD TRAINING PASSED: ${MODALITY}"
