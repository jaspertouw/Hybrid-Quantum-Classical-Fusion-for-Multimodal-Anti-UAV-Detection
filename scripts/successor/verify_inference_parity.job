#!/bin/bash
#SBATCH --account=gisr139746
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=verify_inference_parity
#SBATCH --array=0-1%2
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=00:30:00
#SBATCH --output=/projects/prjs2348/mm-uav-threat-detection/logs/%x_%A_%a.out

set -euo pipefail
readonly REPO="${HOME}/mm-uav-threat-detection"
readonly PROJECT_ROOT="/projects/prjs2348/mm-uav-threat-detection"
readonly MODALITIES=(thermal rgb)
readonly MODALITY="${MODALITIES[${SLURM_ARRAY_TASK_ID}]}"
readonly PRECISION="${PARITY_PRECISION:-inherited}"
test ! -e "${PROJECT_ROOT}/data/Anti-UAV-RGBT/test"
module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${HOME}/.conda/envs/thesis-detector"
export PYTHONPATH="${REPO}:${REPO}/resources/EDTC:${REPO}/resources/EDTC/yolov5:${PYTHONPATH:-}"
cd "${REPO}"
echo "Job: ${SLURM_JOB_ID}; repository: $(git rev-parse HEAD)"
srun python -u scripts/successor/verify_inference_parity.py \
    --detector-pair-manifest "${PROJECT_ROOT}/outputs/manifests/detector_pair_v1.json" \
    --derived-root "${PROJECT_ROOT}/data/derived/yolo_inherited_v1" \
    --modality "${MODALITY}" \
    --precision "${PRECISION}" \
    --val-txt "${PROJECT_ROOT}/data/derived/yolo_inherited_v1/${MODALITY}/val_images.txt" \
    --output "${PROJECT_ROOT}/outputs/validation_candidates/v1/${MODALITY}_parity_${PRECISION}.json"
