#!/bin/bash
#SBATCH --account=gisr139746
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=pilot_presence_opinions
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --time=00:15:00
#SBATCH --output=/projects/prjs2348/mm-uav-threat-detection/logs/%x_%j.out

set -euo pipefail
readonly REPO="${HOME}/mm-uav-threat-detection"
readonly PROJECT_ROOT="/projects/prjs2348/mm-uav-threat-detection"
module purge
module load 2024 Miniconda3/24.7.1-0 CUDA/12.6.0
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${HOME}/.conda/envs/thesis-detector"
export PYTHONPATH="${REPO}:${REPO}/resources/EDTC:${REPO}/resources/EDTC/yolov5:${PYTHONPATH:-}"
export PYTHONWARNINGS="ignore::FutureWarning,ignore::UserWarning"
cd "${REPO}"
echo "Job: ${SLURM_JOB_ID}; repository: $(git rev-parse HEAD)"
# CPU-sized synthetic tests first; fail before loading datasets/models if broken.
python -m unittest discover -s tests -p test_presence_opinions.py -q
srun python -u scripts/successor/pilot_presence_opinions.py \
    --phase2-manifest "${PROJECT_ROOT}/outputs/manifests/phase2_completion_v1.json" \
    --dataset-root "${PROJECT_ROOT}/data/Anti-UAV-RGBT" \
    --derived-root "${PROJECT_ROOT}/data/derived/yolo_inherited_v1" \
    --output-root "${PROJECT_ROOT}/outputs/opinion_pilots/v1/${SLURM_JOB_ID}"
