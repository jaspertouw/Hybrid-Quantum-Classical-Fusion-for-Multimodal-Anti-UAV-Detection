#!/bin/bash
#SBATCH --account=gisr139746
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=verify_detector_env
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=00:10:00
#SBATCH --output=/projects/prjs2348/mm-uav-threat-detection/logs/%x_%j.out

set -euo pipefail

readonly REPO="${HOME}/mm-uav-threat-detection"
readonly ENV_PREFIX="${HOME}/.conda/envs/thesis-detector"

test -d "${REPO}/.git"
test -x "${ENV_PREFIX}/bin/python"

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${ENV_PREFIX}"

echo "Job: ${SLURM_JOB_ID:-interactive} on $(hostname)"
echo "Repository: ${REPO} ($(git -C "${REPO}" rev-parse --short HEAD))"
module list 2>&1
nvidia-smi

srun python - <<'PY'
import platform

import cv2
import einops
import timm
import torch
import yacs
import yaml

assert torch.cuda.is_available(), "PyTorch cannot access the allocated GPU"
device = torch.device("cuda")
x = torch.randn(256, 256, device=device)
y = (x @ x).square().mean()
assert torch.isfinite(y), "GPU smoke calculation produced a non-finite result"

print("Python:", platform.python_version())
print("PyTorch:", torch.__version__)
print("PyTorch CUDA runtime:", torch.version.cuda)
print("GPU:", torch.cuda.get_device_name(0))
print("GPU smoke value:", y.item())
print("Key detector imports: OK")
print("DETECTOR ENVIRONMENT GPU VERIFICATION PASSED")
PY
