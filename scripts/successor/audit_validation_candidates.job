#!/bin/bash
#SBATCH --account=gisr139746
#SBATCH --partition=rome
#SBATCH --job-name=audit_val_candidates
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --time=00:30:00
#SBATCH --output=/projects/prjs2348/mm-uav-threat-detection/logs/%x_%j.out

set -euo pipefail

readonly REPO="${HOME}/mm-uav-threat-detection"
readonly ENV_PREFIX="${HOME}/.conda/envs/thesis-detector"
readonly PROJECT_ROOT="/projects/prjs2348/mm-uav-threat-detection"
readonly DATA_ROOT="${PROJECT_ROOT}/data/Anti-UAV-RGBT"
readonly MANIFEST_ROOT="${PROJECT_ROOT}/outputs/manifests"
readonly CANDIDATE_ROOT="${PROJECT_ROOT}/outputs/validation_candidates/v1"

test -d "${REPO}/.git"
test -x "${ENV_PREFIX}/bin/python"
test -f "${CANDIDATE_ROOT}/rgb.jsonl"
test -f "${CANDIDATE_ROOT}/thermal.jsonl"
test ! -e "${DATA_ROOT}/test"

module purge >/dev/null 2>&1
module load 2024 >/dev/null 2>&1
module load Miniconda3/24.7.1-0 >/dev/null 2>&1
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${ENV_PREFIX}"

export PYTHONPATH="${REPO}:${PYTHONPATH:-}"
export PYTHONWARNINGS="ignore::FutureWarning,ignore::UserWarning"
cd "${REPO}"

echo "Job: ${SLURM_JOB_ID}; repository: $(git rev-parse HEAD)"
srun python -u scripts/successor/audit_validation_candidates.py \
    --detector-pair-manifest "${MANIFEST_ROOT}/detector_pair_v1.json" \
    --rgb-shard "${CANDIDATE_ROOT}/rgb.jsonl" \
    --thermal-shard "${CANDIDATE_ROOT}/thermal.jsonl" \
    --output "${CANDIDATE_ROOT}/paired_validation_audit_v2.json"
