#!/bin/bash
#SBATCH --account=gisr139746
#SBATCH --partition=rome
#SBATCH --job-name=check_opinion_calibration
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=8G
#SBATCH --time=00:10:00
#SBATCH --output=/projects/prjs2348/mm-uav-threat-detection/logs/%x_%j.out

set -euo pipefail
readonly REPO="${HOME}/mm-uav-threat-detection"
readonly PROJECT_ROOT="/projects/prjs2348/mm-uav-threat-detection"
module purge
module load 2024 Miniconda3/24.7.1-0
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "${HOME}/.conda/envs/thesis-detector"
export PYTHONPATH="${REPO}:${PYTHONPATH:-}"
export CUDA_VISIBLE_DEVICES=""
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8
cd "${REPO}"
echo "Job: ${SLURM_JOB_ID}; repository: $(git rev-parse HEAD)"
python -m unittest discover -s tests -p test_opinion_calibration.py -q
srun python -u scripts/successor/check_opinion_calibration.py \
    --phase2-manifest "${PROJECT_ROOT}/outputs/manifests/phase2_completion_v1.json" \
    --dataset-root "${PROJECT_ROOT}/data/Anti-UAV-RGBT" \
    --objective-report "${PROJECT_ROOT}/outputs/opinion_objectives/v1/29154321/report.json" \
    --feature-reference "${PROJECT_ROOT}/outputs/opinion_diagnostics/v1/29153656/report.json" \
    --output-root "${PROJECT_ROOT}/outputs/opinion_calibration/v1/${SLURM_JOB_ID}"
