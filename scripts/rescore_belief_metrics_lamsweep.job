#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=rescore_belief_lamsweep
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=00:30:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/rescore_belief_lamsweep_%A.out

# DBF lambda sweep — belief-quality (ECE / AUROC / AUSE) rescoring stage.
# These metrics score the FUSED BELIEF distribution (not the bbox), so they are
# exactly what separates lambda values: lambda leaves Acc / boxes identical but
# reshapes b_uav / u_fused.  Writes summary_belief_metrics.json into each
# per-lambda VAL dir.  CPU-only; partition needs a GPU only for resource access.
#
# Prerequisite: eval_detector_only_dbf_lamsweep.job (VAL) must have produced
# val_results_detector_only_dbf_peak_lam<tag>/ for each lambda.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
BASE=$PRETRAINED/edtc_fusion
VAL=$DATA/val

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH
cd $REPO

# --- lambda grid (must match eval_detector_only_dbf_lamsweep.job) ---
LAMS=(0.25 0.5 1.0 2.0 4.0)

for LAM in "${LAMS[@]}"; do
    TAG=${LAM/./p}
    D=$BASE/val_results_detector_only_dbf_peak_lam$TAG
    if [ -d "$D" ]; then
        echo ""; echo "==> lam=$LAM  $D"
        srun --ntasks=1 python -u -m src.edtc_fusion.rescore_belief_metrics \
            --results_dir "$D" --dataset_root "$VAL"
    else
        echo "[skip] $D (missing)"
    fi
done

echo ""
echo "============================================================"
echo "DBF lambda-sweep belief rescoring complete."
echo "Each per-lambda dir now has summary_belief_metrics.json (ECE / AUROC / AUSE)."
echo "Select lambda by best AUROC / lowest ECE; then run TEST for that lambda."
echo "============================================================"
