#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=separability_detonly
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=00:30:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/separability_detonly_%A.out

# Det-only uncertainty separability: failure-detection AUROC for u_fused, b_uav,
# and sigma2_best on the validation _peak logs.  No DETECT/TRACK split (det-only
# has a single detection decision), conditioned on argmax(b_fused)==UAV to match
# the tracker separability table (Table: AUROC separability).
#
# CPU-only workload; gpu_mig is used only for resource access (partition needs a GPU).
# Prerequisite: the eval_detector_only_*.job (_peak) runs must have completed.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
BASE=$PRETRAINED/edtc_fusion
VAL=$DATA/val
OUT=$REPO/reports/separability_detonly
SUCCESS_IOU=0.5          # failure := IoU < SUCCESS_IOU. Set 0.00001 to match
                         # the EDTC IoU=1e-5 localisation-failure flag.

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH
mkdir -p $OUT $REPO/logs
cd $REPO

run () {  # $1=config name   $2=modality (ir|rgb|fusion)
    D=$BASE/val_results_detector_only_$1_peak
    if [ -d "$D" ]; then
        echo ""; echo "==> $1 ($2)"
        srun --ntasks=1 python -u scripts/analyse_uncertainty_separability_detonly.py \
            --results_dir  "$D" \
            --dataset_root "$VAL" \
            --modality     "$2" \
            --success_iou  $SUCCESS_IOU \
            --out_dir      "$OUT/$1_val"
    else
        echo "[skip] $D (missing)"
    fi
}

run ir    ir
run rgb   rgb
run dbf   fusion
run abf   fusion
run naive fusion
run gated fusion

echo ""
echo "============================================================"
echo "Det-only separability complete."
echo "Per-config results -> $OUT/<config>_val/separability_detonly.json"
echo "Histograms + ROC    -> $OUT/<config>_val/*.png"
echo "============================================================"
