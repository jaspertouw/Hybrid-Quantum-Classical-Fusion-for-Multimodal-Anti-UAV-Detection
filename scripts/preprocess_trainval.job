#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=preprocess_antiuav
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=08:00:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/preprocess_trainval_%A.out

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
EDTC=$REPO/resources/EDTC

export PYTHONPATH=$EDTC:$EDTC/yolov5:$PYTHONPATH

cd $REPO

srun python scripts/preprocess_antiuav_trainval.py

echo "Preprocessing complete."
