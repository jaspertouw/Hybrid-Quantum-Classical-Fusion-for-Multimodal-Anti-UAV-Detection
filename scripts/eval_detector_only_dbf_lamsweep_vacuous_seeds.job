#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=detonly_dbf_lamsweep_vacuous
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --array=0-11%2
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/detector_only_dbf_lamsweep_vacuous_%A_%a.out

# DBF lambda sweep x seeds — VAL eval, vacuous missing-detection encoding.
# Grid: 3 seeds x {0.25, 0.5, 2.0, 4.0} = 12 array tasks.
# lambda=1.0 is covered by eval_detector_only_dbf_vacuous_seeds.job
# (val_results_detector_only_dbf_peak_vacuous_seed<S>).
#
# Expectation: with C = 0 on single-detection frames and C <= 1.4e-7
# elsewhere, eta = 1 at every lambda — all rows should coincide with the
# lambda=1.0 run at reported precision (lambda=0.25 may shift ECE in the
# third decimal by amplifying numerical-noise conflict; no decision changes).

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

SEEDS=(0 1 2)
LAMS=(0.25 0.5 2.0 4.0)        # lambda=1.0 covered by the vacuous seed runs
SEED=${SEEDS[$((SLURM_ARRAY_TASK_ID / 4))]}
LAM=${LAMS[$((SLURM_ARRAY_TASK_ID % 4))]}
TAG=${LAM/./p}

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
RESULTS=$PRETRAINED/edtc_fusion/val_results_detector_only_dbf_peak_vacuous_seed${SEED}_lam$TAG

# Seed 0 checkpoints carry no seed suffix (original run); seeds 1-2 do.
if [ "$SEED" -eq 0 ]; then
  YOLO_IR=$PRETRAINED/evidential/evidential_ir_stage2_best.pt
  YOLO_IR_BASE=$PRETRAINED/best_clean.pt
  YOLO_RGB=$PRETRAINED/evidential/evidential_rgb_stage2_best.pt
  YOLO_RGB_BASE=$PRETRAINED/best_clean_rgb.pt
else
  YOLO_IR=$PRETRAINED/evidential/evidential_ir_stage2_seed${SEED}_best.pt
  YOLO_IR_BASE=$PRETRAINED/best_clean_seed${SEED}.pt
  YOLO_RGB=$PRETRAINED/evidential/evidential_rgb_stage2_seed${SEED}_best.pt
  YOLO_RGB_BASE=$PRETRAINED/best_clean_rgb_seed${SEED}.pt
fi

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH

mkdir -p $RESULTS
mkdir -p $REPO/logs

cd $REPO

echo "=== DBF lambda sweep [VAL, vacuous]  seed=$SEED  lam=$LAM  tag=$TAG ==="

srun python -u -m src.edtc_fusion.run_detector_only \
    --mode          dbf \
    --dataset_root  $DATA/val \
    --results_dir   $RESULTS \
    --unc_agg       peak \
    --miss_belief   vacuous \
    --yolo_ir       $YOLO_IR \
    --yolo_ir_base  $YOLO_IR_BASE \
    --yolo_rgb      $YOLO_RGB \
    --yolo_rgb_base $YOLO_RGB_BASE \
    --fusion        dbf \
    --lam           $LAM

echo ""
echo "DBF (vacuous) seed=$SEED lam=$LAM complete. Summary: $RESULTS/summary.json"
echo "Next: rescore_belief_metrics_lamsweep_vacuous.job"
