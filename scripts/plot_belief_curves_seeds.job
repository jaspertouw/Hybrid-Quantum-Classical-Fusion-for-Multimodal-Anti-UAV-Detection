#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=plot_belief_curves_seeds
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=00:45:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/plot_belief_curves_seeds_%A.out

# Seed-AGGREGATED reliability + sparsification (belief & sigma2) figures for the
# DET-ONLY runs — mean ± std over seeds 0-2.  These are the thesis main-text
# versions (no arbitrary single-seed pick).  CPU-only workload (matplotlib Agg,
# no model loads) — GPU requested only to match the rescore job's proven access.
#
# Reads, per method, seeds 0-2.  Seed 0 is the original pre-seeds run, so its
# folder has NO "_seed0" suffix; seeds 1,2 carry "_seed{n}".
#   single-modality baselines (no fusion/gate -> encoding-invariant, mix cleanly):
#     seed0 : {val,test}_results_detector_only_{ir,rgb}_peak
#     seed12: val_results_detector_only_{ir,rgb}_seed{1,2}        (val has no _peak)
#             test_results_detector_only_{ir,rgb}_peak_seed{1,2}
#   fusion methods (vacuous miss-encoding — corrected main results, seed0 explicit):
#     {val,test}_results_detector_only_{dbf,abf,naive}_peak_vacuous_seed{0,1,2}
#   Gated (non-vacuous only; belief figures encoding-invariant, sigma not — footnote it):
#     seed0 : {val,test}_results_detector_only_gated_peak
#     seed12: {val,test}_results_detector_only_gated_peak_seed{1,2}
#   DMS (belief-free, sigma figure only):
#     seed0 : {val,test}_results_detector_only_dms
#     seed12: {val,test}_results_detector_only_dms_seed{1,2}
# Writes 6 PNGs to BASE/figures:
#   reliability_seeds_{val,test}.png
#   sparsification_belief_seeds_{val,test}.png
#   sparsification_sigma_seeds_{val,test}.png   <- DMS appears here
#
# Submit with:
#   sbatch scripts/plot_belief_curves_seeds.job

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH
cd $REPO

srun --ntasks=1 python -u -m src.edtc_fusion.plot_belief_curves_seeds \
    --pretrained "$PRETRAINED" \
    --val_root   "$DATA/val" \
    --test_root  "$DATA/test"

echo ""
echo "============================================================"
echo "Seed-aggregated belief-curve figures written to:"
echo "  $PRETRAINED/edtc_fusion/figures/"
echo "============================================================"
