#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=stage2_evi_ir_seeds
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=10:00:00
#SBATCH --array=0-1%1
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/stage2_evidential_ir_seed_%A_%a.out

# Phase 3.3 Stage 2 — Evidential head training: IR stream, multi-seed.
#
# Seed 0 = the existing evidential_ir_stage2 run, so this trains seeds 1 and 2.
# Each seed consumes the matching Stage 1g checkpoint and clean base for that seed.
# Precondition: stage1_gaussian_ir_seeds.job has completed for seeds 1 and 2.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

SEEDS=(1 2)
SEED=${SEEDS[$SLURM_ARRAY_TASK_ID]}

REPO=/home/ssuttorp/mm-uav-threat-detection
EDTC=$REPO/resources/EDTC
DATA=/home/ssuttorp/Anti-UAV-RGBT
EVI=/home/ssuttorp/pretrained_models/evidential

export PYTHONPATH=$EDTC:$EDTC/yolov5:$PYTHONPATH

mkdir -p $REPO/logs

# Guard: confirm this seed's Stage 1g checkpoint exists.
if [ ! -f "$EVI/evidential_ir_stage1g_seed${SEED}_last.pt" ]; then
    echo "ERROR: $EVI/evidential_ir_stage1g_seed${SEED}_last.pt not found."
    echo "Run stage1_gaussian_ir_seeds.job first for seed ${SEED}."
    exit 1
fi

cd $EDTC

echo "Stage 2 evidential IR — seed=${SEED}"

srun python -u lib/models/yolo_evidential/train_stage2_evidential.py \
    --stage1_checkpoint $EVI/evidential_ir_stage1g_seed${SEED}_last.pt \
    --base_weights      /home/ssuttorp/pretrained_models/best_clean_seed${SEED}.pt \
    --data              $REPO/resources/EDTC/yolov5/data/antiuav_clean.yaml \
    --train_txt         $DATA/train_ir_images.txt \
    --val_txt           $DATA/val_ir_images.txt \
    --save_dir          $EVI \
    --name              evidential_ir_stage2_seed${SEED} \
    --device            0 \
    --epochs            20 \
    --batch_size        64 \
    --workers           8 \
    --lr                1e-3 \
    --lambda_evi        1.0 \
    --K                 2 \
    --check_every       5 \
    --seed              $SEED \
    --resume

echo ""
echo "Stage 2 evidential IR seed=${SEED} complete."
echo "Best checkpoint : $EVI/evidential_ir_stage2_seed${SEED}_best.pt"
