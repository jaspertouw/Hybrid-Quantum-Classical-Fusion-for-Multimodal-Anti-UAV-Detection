#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=detector_only_abf_vacuous
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --array=0-2
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/detector_only_abf_vacuous_seed_%A_%a.out

# Detector-only ABF with the corrected missing-detection encoding
# (--miss_belief vacuous: b=(0,0), u=1 instead of the legacy _ZERO_UNC
# dogmatic-background placeholder b=(0,1), u=1).  Companion run to
# eval_detector_only_{dbf,naive}_vacuous_seeds.job; everything else identical.
#
# WHY this is needed (despite the rescore job exempting ABF):
#   ABF's *belief signals* (b_uav = b_fused[0], u_fused) are encoding-invariant
#   — they ignore b_bg, so ECE/AUROC/AUSE-belief are provably unchanged.
#   BUT the emission gate is  (b_uav > b_bg) AND (u_fused < theta_cls), and
#   b_bg = b_fused[1] DOES change with the encoding on single-modality-miss
#   frames (dogmatic adds the missing stream's u-mass into b_bg).  Every metric
#   in the localisation table (AP@0.5, mAP, mIoU, EDTC-Acc, State-Acc, AUSE_sigma)
#   is computed from the *gated emitted boxes*, so ABF's loc metrics are NOT
#   guaranteed identical between encodings.  Re-run under vacuous so the ABF row
#   shares the same miss-encoding as the DBF/naive rows.
#
# ABF is invoked as --mode dbf --fusion abf (there is no standalone abf mode);
# --lam is irrelevant to ABF and is omitted.
#
# Produces both val and test results so the existing rescore job
# (rescore_belief_metrics_vacuous.job extended to abf) and the aggregator
# (aggregate_vacuous_belief_metrics.py) pick them up under the *_abf_peak_vacuous_*
# naming.
#
# Submit with:
#   sbatch scripts/eval_detector_only_abf_vacuous_seeds.job

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

SEED=$SLURM_ARRAY_TASK_ID

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models

# Seed 0 checkpoints carry no seed suffix (original run); seeds 1-2 do.
if [ "$SEED" -eq 0 ]; then
  YOLO_IR=$PRETRAINED/evidential/evidential_ir_stage2_best.pt
  YOLO_IR_BASE=$PRETRAINED/best_clean.pt
  YOLO_RGB=$PRETRAINED/evidential/evidential_rgb_stage2_best.pt
  YOLO_RGB_BASE=$PRETRAINED/best_clean_rgb.pt
else
  YOLO_IR=$PRETRAINED/evidential/evidential_ir_stage2_seed${SEED}_best.pt
  YOLO_IR_BASE=$PRETRAINED/best_clean_seed${SEED}.pt
  YOLO_RGB=$PRETRAINED/evidential/evidential_rgb_stage2_seed${SEED}_best.pt
  YOLO_RGB_BASE=$PRETRAINED/best_clean_rgb_seed${SEED}.pt
fi

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH
mkdir -p $REPO/logs
cd $REPO

for SPLIT in val test; do
    RESULTS=$PRETRAINED/edtc_fusion/${SPLIT}_results_detector_only_abf_peak_vacuous_seed${SEED}
    mkdir -p $RESULTS
    echo ""
    echo "Detector-only ABF (vacuous miss encoding) eval — split=${SPLIT} seed=${SEED}"
    srun python -u -m src.edtc_fusion.run_detector_only \
        --mode          dbf \
        --dataset_root  $DATA/${SPLIT} \
        --results_dir   $RESULTS \
        --unc_agg       peak \
        --miss_belief   vacuous \
        --yolo_ir       $YOLO_IR \
        --yolo_ir_base  $YOLO_IR_BASE \
        --yolo_rgb      $YOLO_RGB \
        --yolo_rgb_base $YOLO_RGB_BASE \
        --fusion        abf
    echo "ABF (vacuous) split=${SPLIT} seed=${SEED} complete. Summary: $RESULTS/summary.json"
done
