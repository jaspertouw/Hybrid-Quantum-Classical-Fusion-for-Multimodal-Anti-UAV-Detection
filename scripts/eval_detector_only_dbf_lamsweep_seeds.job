#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=detonly_dbf_lamsweep_seeds
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --array=0-7%2
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/detector_only_dbf_lamsweep_seed_%A_%a.out

# DBF lambda sweep x seeds — VAL eval for seeds 1 and 2.
# Seed 0 lambda sweep already exists (val_results_detector_only_dbf_peak_lam<tag>).
# lambda=1.0 for seeds 1/2 already exists (val_results_detector_only_dbf_peak_seed<S>
# from eval_detector_only_dbf_seeds.job), so the grid here is only the remaining
# four lambdas per seed: 2 seeds x {0.25, 0.5, 2.0, 4.0} = 8 array tasks.
#
# Purpose: confirm the lambda=1.0 selection is seed-robust and enable
# mean+-std-over-seeds reporting per lambda (same protocol as the other seed
# aggregations).  Precondition: stage2 evidential seed checkpoints exist.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

SEEDS=(1 2)
LAMS=(0.25 0.5 2.0 4.0)        # lambda=1.0 covered by existing _seed<S> runs
SEED=${SEEDS[$((SLURM_ARRAY_TASK_ID / 4))]}
LAM=${LAMS[$((SLURM_ARRAY_TASK_ID % 4))]}
TAG=${LAM/./p}

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
RESULTS=$PRETRAINED/edtc_fusion/val_results_detector_only_dbf_peak_seed${SEED}_lam$TAG

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH

mkdir -p $RESULTS
mkdir -p $REPO/logs

cd $REPO

echo "=== DBF lambda sweep x seeds [VAL]  seed=$SEED  lam=$LAM  tag=$TAG ==="

srun python -u -m src.edtc_fusion.run_detector_only \
    --mode          dbf \
    --dataset_root  $DATA/val \
    --results_dir   $RESULTS \
    --unc_agg       peak \
    --yolo_ir       $PRETRAINED/evidential/evidential_ir_stage2_seed${SEED}_best.pt \
    --yolo_ir_base  $PRETRAINED/best_clean_seed${SEED}.pt \
    --yolo_rgb      $PRETRAINED/evidential/evidential_rgb_stage2_seed${SEED}_best.pt \
    --yolo_rgb_base $PRETRAINED/best_clean_rgb_seed${SEED}.pt \
    --fusion        dbf \
    --lam           $LAM

echo ""
echo "Detector-only DBF seed=$SEED lam=$LAM complete. Summary: $RESULTS/summary.json"
echo "Next: rescore_belief_metrics_lamsweep_seeds.job"
