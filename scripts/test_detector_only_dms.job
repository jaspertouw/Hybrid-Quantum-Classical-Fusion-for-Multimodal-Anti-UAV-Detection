#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=test_detector_dms
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=02:00:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/test_detector_only_dms_%A.out

# TEST SET EVALUATION — Detector-only DMS baseline (DMS box selection only).
# No fusion, no suppression gate.  Acc is Option-B (DMS-aware).
# summary.json includes computational efficiency (params / GFLOPs / mean FPS).

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
RESULTS=$PRETRAINED/edtc_fusion/test_results_detector_only_dms

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH

mkdir -p $RESULTS
mkdir -p $REPO/logs

cd $REPO

srun python -u -m src.edtc_fusion.run_detector_only \
    --mode          dms \
    --dataset_root  $DATA/test \
    --results_dir   $RESULTS \
    --yolo_ir       $PRETRAINED/evidential/evidential_ir_stage2_best.pt \
    --yolo_ir_base  $PRETRAINED/best_clean.pt \
    --yolo_rgb      $PRETRAINED/evidential/evidential_rgb_stage2_best.pt \
    --yolo_rgb_base $PRETRAINED/best_clean_rgb.pt

echo ""
echo "============================================================"
echo "  TEST SET EVALUATION COMPLETE — Detector-only DMS"
echo "  Split   : TEST"
echo "  Summary : $RESULTS/summary.json  (incl. efficiency: params/GFLOPs/FPS)"
echo "  Acc     : DMS-aware (Option-B)"
echo "============================================================"
