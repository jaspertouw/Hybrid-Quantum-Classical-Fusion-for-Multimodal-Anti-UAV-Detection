#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=detector_only_naive_vacuous
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --array=0-2%1
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/detector_only_naive_vacuous_seed_%A_%a.out

# VALIDATION — Detector-only Naive Late Fusion with the corrected
# missing-detection encoding (--miss_belief vacuous: b=(0,0), u=1 instead of
# the legacy _ZERO_UNC dogmatic-background placeholder b=(0,1), u=1).
# Companion run to eval_detector_only_naive(_seeds).job; everything else
# identical.  Expected: Acc rises to ABF level (~0.80/0.76/0.77), confirming
# the DBF/naive deficit is caused solely by the placeholder encoding.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

SEED=$SLURM_ARRAY_TASK_ID

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
RESULTS=$PRETRAINED/edtc_fusion/val_results_detector_only_naive_peak_vacuous_seed${SEED}

# Seed 0 checkpoints carry no seed suffix (original run); seeds 1-2 do.
if [ "$SEED" -eq 0 ]; then
  YOLO_IR=$PRETRAINED/evidential/evidential_ir_stage2_best.pt
  YOLO_IR_BASE=$PRETRAINED/best_clean.pt
  YOLO_RGB=$PRETRAINED/evidential/evidential_rgb_stage2_best.pt
  YOLO_RGB_BASE=$PRETRAINED/best_clean_rgb.pt
else
  YOLO_IR=$PRETRAINED/evidential/evidential_ir_stage2_seed${SEED}_best.pt
  YOLO_IR_BASE=$PRETRAINED/best_clean_seed${SEED}.pt
  YOLO_RGB=$PRETRAINED/evidential/evidential_rgb_stage2_seed${SEED}_best.pt
  YOLO_RGB_BASE=$PRETRAINED/best_clean_rgb_seed${SEED}.pt
fi

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH

mkdir -p $RESULTS
mkdir -p $REPO/logs

cd $REPO

echo "Detector-only Naive (vacuous miss encoding) eval — seed=${SEED}"

srun python -u -m src.edtc_fusion.run_detector_only \
    --mode          naive \
    --dataset_root  $DATA/val \
    --results_dir   $RESULTS \
    --unc_agg       peak \
    --miss_belief   vacuous \
    --yolo_ir       $YOLO_IR \
    --yolo_ir_base  $YOLO_IR_BASE \
    --yolo_rgb      $YOLO_RGB \
    --yolo_rgb_base $YOLO_RGB_BASE

echo ""
echo "Naive (vacuous) seed=${SEED} complete. Summary: $RESULTS/summary.json"
