#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=train_yolo_clean
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=12:00:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/train_yolo_clean_%A.out

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
EDTC=$REPO/resources/EDTC
CHECKPOINT=$EDTC/yolov5/runs/train/antiuav_clean/weights/last.pt

export PYTHONPATH=$EDTC:$EDTC/yolov5:$PYTHONPATH

cd $EDTC/yolov5

# Resume from last checkpoint if one exists (e.g. after a timeout or manual cancel),
# otherwise start fresh from COCO pretrained weights.
# Note: --resume overrides --data/--weights/--epochs from the saved checkpoint state,
# so the original 20-epoch target and dataset config are preserved automatically.
if [ -f "$CHECKPOINT" ]; then
    echo "Resuming from $CHECKPOINT"
    # Cache files are valid when resuming — do not delete them
    srun python train.py --resume "$CHECKPOINT"
else
    echo "No checkpoint found, starting fresh"
    # Remove any stale cache files from previous failed runs
    rm -f /home/ssuttorp/Anti-UAV-RGBT/train_ir_images.cache
    rm -f /home/ssuttorp/Anti-UAV-RGBT/val_ir_images.cache

    srun python train.py \
        --data $REPO/resources/EDTC/yolov5/data/antiuav_clean.yaml \
        --weights $EDTC/yolov5/yolov5s.pt \
        --img 640 \
        --epochs 20 \
        --batch-size 64 \
        --workers 8 \
        --project $EDTC/yolov5/runs/train \
        --name antiuav_clean \
        --exist-ok
fi

# Copy clean checkpoint to pretrained_models for use by EDTC tracker
cp $EDTC/yolov5/runs/train/antiuav_clean/weights/best.pt \
   /home/ssuttorp/pretrained_models/best_clean.pt

echo "Training complete. Clean checkpoint saved to pretrained_models/best_clean.pt"
