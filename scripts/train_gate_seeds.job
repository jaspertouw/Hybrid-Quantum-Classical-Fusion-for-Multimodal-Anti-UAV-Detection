#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=train_gate_seeds
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=16:00:00
#SBATCH --array=0-1%1
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/train_gate_seed_%A_%a.out

# Gate MLP training — per-seed, for seeds 1 and 2.
#
# Seed 0 = the existing gate_best.pth run.
#
# train_gate.py has no --seed flag, so the gate's own init RNG is fixed.
# The seed dependence comes entirely from the INPUT BELIEFS: the gate must be
# fit on the beliefs produced by the seed-specific YOLO detectors, otherwise a
# seed-1 gated eval would run a gate that was fit to seed-0 beliefs (confounded).
#
# IMPORTANT: each seed gets its OWN belief cache dir + gate output, so the
# cached seed-0 beliefs are never reused for a different seed.
#
# SiamCAR weights have no seed variants — they are intentionally shared across
# seeds (only the YOLO inputs differ).
#
# Precondition: stage2_evidential_{ir,rgb}_seeds.job completed for seeds 1 and 2.
# Run this BEFORE eval_detector_only_gated_seeds.job.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

SEEDS=(1 2)
SEED=${SEEDS[$SLURM_ARRAY_TASK_ID]}

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
GATE_OUT=$PRETRAINED/gated_fusion/gate_best_seed${SEED}.pth
CACHE_DIR=$PRETRAINED/gated_fusion/belief_cache_seed${SEED}

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH

mkdir -p $PRETRAINED/gated_fusion
mkdir -p $REPO/logs

cd $REPO

EPOCHS=20
LR=1e-3
BATCH_SIZE=256

echo "============================================================"
echo "Gate MLP training — seed=${SEED}"
echo "  gate_out   : $GATE_OUT"
echo "  cache_dir  : $CACHE_DIR  (per-seed — seed-0 beliefs NOT reused)"
echo "============================================================"
echo ""

srun python -u -m src.edtc_fusion.train_gate \
    --train_root          $DATA/train \
    --val_root            $DATA/val \
    --gate_out            $GATE_OUT \
    --cache_dir           $CACHE_DIR \
    --epochs              $EPOCHS \
    --lr                  $LR \
    --batch_size          $BATCH_SIZE \
    --yolo_ir             $PRETRAINED/evidential/evidential_ir_stage2_seed${SEED}_best.pt \
    --yolo_rgb            $PRETRAINED/evidential/evidential_rgb_stage2_seed${SEED}_best.pt \
    --yolo_ir_base        $PRETRAINED/best_clean_seed${SEED}.pt \
    --yolo_rgb_base       $PRETRAINED/best_clean_rgb_seed${SEED}.pt \
    --siam_ir_stage2      $PRETRAINED/siamcar_gaussian/siamcar_ir_stage2_best.pth \
    --siam_rgb_stage2     $PRETRAINED/siamcar_gaussian/siamcar_rgb_stage2_best.pth \
    --siam_ir_stage1      $PRETRAINED/siamcar_gaussian/siamcar_ir_stage1g_best.pth \
    --siam_rgb_stage1     $PRETRAINED/siamcar_gaussian/siamcar_rgb_stage1g_best.pth \
    --siam_ir_pretrained  $PRETRAINED/siamcar_thermal_final.pth \
    --siam_rgb_pretrained $PRETRAINED/siamcar_rgb_final.pth \
    --siam_ir_cfg         $REPO/resources/SiamCAR/experiments/siamcar_r50/config_antiuav_thermal.yaml \
    --siam_rgb_cfg        $REPO/resources/SiamCAR/experiments/siamcar_r50/config_antiuav_rgb.yaml

echo ""
echo "Gate training seed=${SEED} complete. Best checkpoint: $GATE_OUT"
