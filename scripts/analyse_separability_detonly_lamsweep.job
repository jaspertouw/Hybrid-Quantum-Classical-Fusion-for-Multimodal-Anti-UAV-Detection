#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=separability_detonly_lamsweep
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=00:30:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/separability_detonly_lamsweep_%A.out

# DBF lambda sweep — uncertainty SEPARABILITY stage.
# Failure-detection AUROC for u_fused, b_uav, sigma2_best on each per-lambda VAL
# log dir.  This is the axis where lambda actually matters: sigma2_best (the DMS
# box selector) is lambda-INVARIANT, so the lambda signal shows up in the
# u_fused / b_uav AUROC.  Conditioned on argmax(b_fused)==UAV (default).
#
# Prerequisite: eval_detector_only_dbf_lamsweep.job (VAL) must have produced
# val_results_detector_only_dbf_peak_lam<tag>/ for each lambda.
# CPU-only workload; partition needs a GPU only for resource access.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
BASE=$PRETRAINED/edtc_fusion
VAL=$DATA/val
OUT=$REPO/reports/separability_detonly_dbf_lamsweep
SUCCESS_IOU=0.5          # failure := IoU < SUCCESS_IOU (match analyse_separability_detonly.job)

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH
mkdir -p $OUT $REPO/logs
cd $REPO

# --- lambda grid (must match eval_detector_only_dbf_lamsweep.job) ---
LAMS=(0.25 0.5 1.0 2.0 4.0)

for LAM in "${LAMS[@]}"; do
    TAG=${LAM/./p}
    D=$BASE/val_results_detector_only_dbf_peak_lam$TAG
    if [ -d "$D" ]; then
        echo ""; echo "==> lam=$LAM (tag=$TAG)"
        srun --ntasks=1 python -u scripts/analyse_uncertainty_separability_detonly.py \
            --results_dir  "$D" \
            --dataset_root "$VAL" \
            --modality     fusion \
            --success_iou  $SUCCESS_IOU \
            --out_dir      "$OUT/lam${TAG}_val"
    else
        echo "[skip] $D (missing)"
    fi
done

echo ""
echo "============================================================"
echo "DBF lambda-sweep separability complete."
echo "Per-lambda results -> $OUT/lam<tag>_val/separability_detonly.json"
echo "Compare u_fused / b_uav auroc_failure across lambda to select lambda."
echo "============================================================"
