#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=rescore_belief_lamsweep_seeds
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=00:30:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/rescore_belief_lamsweep_seeds_%A.out

# DBF lambda sweep x seeds — belief-quality (ECE / AUROC / AUSE) rescoring for
# seeds 1 and 2.  Writes summary_belief_metrics.json into each per-seed
# per-lambda VAL dir.  lambda=1.0 maps to the existing _seed<S> dirs (no _lam1p0
# suffix), so those are rescored in place (a no-op if already rescored by
# rescore_belief_metrics_seeds.job).
#
# Prerequisite: eval_detector_only_dbf_lamsweep_seeds.job completed.
# CPU-only workload; partition needs a GPU only for resource access.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
BASE=$PRETRAINED/edtc_fusion
VAL=$DATA/val

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH
cd $REPO

SEEDS=(1 2)
LAMS=(0.25 0.5 1.0 2.0 4.0)

for SEED in "${SEEDS[@]}"; do
    for LAM in "${LAMS[@]}"; do
        TAG=${LAM/./p}
        if [ "$LAM" = "1.0" ]; then
            D=$BASE/val_results_detector_only_dbf_peak_seed${SEED}
        else
            D=$BASE/val_results_detector_only_dbf_peak_seed${SEED}_lam$TAG
        fi
        if [ -d "$D" ]; then
            echo ""; echo "==> seed=$SEED lam=$LAM  $D"
            srun --ntasks=1 python -u -m src.edtc_fusion.rescore_belief_metrics \
                --results_dir "$D" --dataset_root "$VAL"
        else
            echo "[skip] $D (missing)"
        fi
    done
done

echo ""
echo "============================================================"
echo "DBF lambda-sweep x seeds belief rescoring complete (seeds 1, 2)."
echo "Aggregate with: python scripts/aggregate_dbf_lambda_seeds.py"
echo "============================================================"
