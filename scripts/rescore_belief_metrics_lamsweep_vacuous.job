#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=rescore_lamsweep_vacuous
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=00:45:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/rescore_lamsweep_vacuous_%A.out

# Belief-quality (ECE / AUROC / spec / bal.acc) rescoring for the vacuous
# DBF lambda sweep (val, seeds 0-2, lambdas 0.25/0.5/2/4).  CPU-only.
# lambda=1.0 rows come from rescore_belief_metrics_vacuous.job
# (val_results_detector_only_dbf_peak_vacuous_seed<S>).
#
# Prerequisite: eval_detector_only_dbf_lamsweep_vacuous_seeds.job completed.
#
# Submit with:
#   sbatch scripts/rescore_belief_metrics_lamsweep_vacuous.job

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
BASE=/home/ssuttorp/pretrained_models/edtc_fusion
VAL=$DATA/val

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH
cd $REPO

for SEED in 0 1 2; do
    for TAG in 0p25 0p5 2p0 4p0; do
        D=$BASE/val_results_detector_only_dbf_peak_vacuous_seed${SEED}_lam$TAG
        if [ -d "$D" ]; then
            echo ""; echo "==> $D"
            srun --ntasks=1 python -u -m src.edtc_fusion.rescore_belief_metrics \
                --results_dir "$D" --dataset_root "$VAL"
        else
            echo "[skip] $D (missing)"
        fi
    done
done

echo ""
echo "============================================================"
echo "Vacuous lambda-sweep rescoring complete."
echo "Aggregate per lambda across seeds 0-2; the lambda=1.0 row is the"
echo "vacuous DBF run (val_results_detector_only_dbf_peak_vacuous_seed<S>)."
echo "Expected: all lambda rows identical at reported precision."
echo "============================================================"
