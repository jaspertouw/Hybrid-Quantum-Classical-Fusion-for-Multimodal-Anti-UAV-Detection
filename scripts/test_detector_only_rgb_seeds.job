#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=test_detector_rgb_seeds
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --array=0-1%1
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/test_detector_only_rgb_seed_%A_%a.out

# TEST SET — Detector-only RGB baseline, per-seed (seeds 1 and 2).
# Seed 0 is the existing test_results_detector_only_rgb_peak run.
# Eval is deterministic given the weights; seed enters only via the weights.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

SEEDS=(1 2)
SEED=${SEEDS[$SLURM_ARRAY_TASK_ID]}

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
RESULTS=$PRETRAINED/edtc_fusion/test_results_detector_only_rgb_peak_seed${SEED}

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH

mkdir -p $RESULTS
mkdir -p $REPO/logs

cd $REPO

echo "TEST Detector-only RGB eval — seed=${SEED}"

srun python -u -m src.edtc_fusion.run_detector_only \
    --mode          rgb \
    --dataset_root  $DATA/test \
    --results_dir   $RESULTS \
    --unc_agg       peak \
    --yolo_rgb      $PRETRAINED/evidential/evidential_rgb_stage2_seed${SEED}_best.pt \
    --yolo_rgb_base $PRETRAINED/best_clean_rgb_seed${SEED}.pt

echo ""
echo "TEST Detector-only RGB seed=${SEED} complete. Summary: $RESULTS/summary.json"
