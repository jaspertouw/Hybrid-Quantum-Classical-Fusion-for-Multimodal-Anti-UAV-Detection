#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=00:30:00
#SBATCH --job-name=calib_detonly_gated
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/calib_detonly_gated_%A.out

# EXACT offline sweep of theta_cls for the detector-only Gated Fusion variant.
# Prerequisite: eval_detector_only_gated.job must have produced *_log.csv
# (with b_bg / dms_box columns) in $LOG_DIR.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
LOG_DIR=$PRETRAINED/edtc_fusion/val_results_detector_only_gated_peak
OUT_DIR=$PRETRAINED/edtc_fusion/calibration_detonly_gated_peak

mkdir -p $OUT_DIR
mkdir -p $REPO/logs

cd $REPO

python scripts/calibrate_detonly_threshold.py \
    --log_dir      $LOG_DIR \
    --dataset_root $DATA/val \
    --out_dir      $OUT_DIR \
    --top_k        10

echo ""
echo "Gated det-only theta_cls sweep complete.  Best -> $OUT_DIR/theta_sweep.json"
