#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=test_detector_gated_seeds
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --array=0-1%1
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/test_detector_only_gated_seed_%A_%a.out

# TEST SET — Detector-only Gated Fusion baseline, per-seed (seeds 1 and 2).
# Seed 0 is the existing test_results_detector_only_gated_peak run.
# Uses the seed-specific gate checkpoint from train_gate_seeds.job.
# theta_cls locked at 0.5 (val sweep found it inert in [0.05,0.95] under peak agg).
# Precondition: train_gate_seeds.job completed for seeds 1 and 2.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

SEEDS=(1 2)
SEED=${SEEDS[$SLURM_ARRAY_TASK_ID]}

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
RESULTS=$PRETRAINED/edtc_fusion/test_results_detector_only_gated_peak_seed${SEED}
GATE=$PRETRAINED/gated_fusion/gate_best_seed${SEED}.pth
THETA_CLS=0.5

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH

# Guard: confirm this seed's gate checkpoint exists.
if [ ! -f "$GATE" ]; then
    echo "ERROR: $GATE not found. Run train_gate_seeds.job first for seed ${SEED}."
    exit 1
fi

mkdir -p $RESULTS
mkdir -p $REPO/logs

cd $REPO

echo "TEST Detector-only Gated Fusion eval — seed=${SEED}"

srun python -u -m src.edtc_fusion.run_detector_only \
    --mode          gated \
    --dataset_root  $DATA/test \
    --results_dir   $RESULTS \
    --unc_agg       peak \
    --yolo_ir       $PRETRAINED/evidential/evidential_ir_stage2_seed${SEED}_best.pt \
    --yolo_ir_base  $PRETRAINED/best_clean_seed${SEED}.pt \
    --yolo_rgb      $PRETRAINED/evidential/evidential_rgb_stage2_seed${SEED}_best.pt \
    --yolo_rgb_base $PRETRAINED/best_clean_rgb_seed${SEED}.pt \
    --gate_weights  $GATE \
    --theta_cls     $THETA_CLS

echo ""
echo "TEST Detector-only Gated seed=${SEED} complete. Summary: $RESULTS/summary.json"
