#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=edtc_no_ufused
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=04:00:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/edtc_no_ufused_%A.out

# Ablation: full YOLO + SiamCAR EDTC pipeline WITHOUT the u_fused gate.
# Gating reduces to:   argmax(b_fused) == UAV  AND  sigma2_best < theta_loc
#
# The two theta_cls thresholds are forced to +inf inside the runner, so the
# u_fused < theta_cls check always passes.  The theta_loc values below should
# match the calibrated DBF run you are comparing against
# (scripts/eval_edtc_fusion_calibrated.job) so the only difference is the
# absence of u_fused gating.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models

# ── Localisation thresholds (must mirror the calibrated baseline) ────────
# Copy these from your chosen top10_candidates.json entry, same as the
# calibrated DBF run, so the ablation isolates only the u_fused contribution.
THETA_LOC_DETECT=0.035
THETA_LOC_TRACK=0.564
# ──────────────────────────────────────────────────────────────────────────

TAG="ld${THETA_LOC_DETECT}_lt${THETA_LOC_TRACK}"
RESULTS=$PRETRAINED/edtc_fusion/val_results_no_ufused_${TAG}

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH

mkdir -p $RESULTS
mkdir -p $REPO/logs

cd $REPO

srun python -u -m src.edtc_fusion.run_edtc_fusion_no_ufused \
    --dataset_root        $DATA/val \
    --results_dir         $RESULTS \
    --yolo_ir             $PRETRAINED/evidential/evidential_ir_stage2_best.pt \
    --yolo_rgb            $PRETRAINED/evidential/evidential_rgb_stage2_best.pt \
    --yolo_ir_base        $PRETRAINED/best_clean.pt \
    --yolo_rgb_base       $PRETRAINED/best_clean_rgb.pt \
    --siam_ir_stage2      $PRETRAINED/siamcar_gaussian/siamcar_ir_stage2_best.pth \
    --siam_rgb_stage2     $PRETRAINED/siamcar_gaussian/siamcar_rgb_stage2_best.pth \
    --siam_ir_stage1      $PRETRAINED/siamcar_gaussian/siamcar_ir_stage1g_best.pth \
    --siam_rgb_stage1     $PRETRAINED/siamcar_gaussian/siamcar_rgb_stage1g_best.pth \
    --siam_ir_pretrained  $PRETRAINED/siamcar_thermal_final.pth \
    --siam_rgb_pretrained $PRETRAINED/siamcar_rgb_final.pth \
    --siam_ir_cfg         $REPO/resources/SiamCAR/experiments/siamcar_r50/config_antiuav_thermal.yaml \
    --siam_rgb_cfg        $REPO/resources/SiamCAR/experiments/siamcar_r50/config_antiuav_rgb.yaml \
    --fusion              dbf \
    --lam                 1.0 \
    --theta_cls_detect    0.0 \
    --theta_loc_detect    $THETA_LOC_DETECT \
    --theta_cls_track     0.0 \
    --theta_loc_track     $THETA_LOC_TRACK

echo ""
echo "No-u_fused ablation run complete."
echo "Gate       : argmax(b_fused)==UAV  AND  sigma2_best < theta_loc"
echo "Thresholds : loc_d=${THETA_LOC_DETECT}  loc_t=${THETA_LOC_TRACK}  (cls_* forced to +inf)"
echo "Results    : $RESULTS/summary.json"
echo "Acc metric : failure_iou_thresh=1e-5  penalty_denom=T_total (matches EDTC eval script)"
