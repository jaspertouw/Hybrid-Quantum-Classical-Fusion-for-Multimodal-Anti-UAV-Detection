#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=rescore_belief_vacuous
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=01:00:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/rescore_belief_vacuous_%A.out

# Belief-quality (ECE / AUROC / AUSE) rescoring for the corrected
# missing-detection-encoding runs (--miss_belief vacuous), DBF + naive + ABF,
# seeds 0-2, val + test.  CPU-only post-hoc pass over the saved logs.
#
# ABF NOTE: ABF's *belief signals* (conf_prob = b_uav + u/2, conf_1mu = 1 - u)
# are encoding-invariant — b_uav = b_fused[0] and u_fused ignore b_bg, so the
# ECE/AUROC/AUSE-belief numbers match the dogmatic ABF run exactly.  BUT the
# emission gate (b_uav > b_bg) uses b_fused[1], which DOES change with the
# encoding on single-modality-miss frames, so ABF's *localisation* metrics
# (AP/mAP/mIoU/EDTC-Acc/State-Acc/AUSE_sigma) are not guaranteed identical.
# ABF is therefore re-run under vacuous (eval_detector_only_abf_vacuous_seeds.job)
# and rescored here so it shares the DBF/naive miss-encoding.
#
# gated is still NOT re-scored under vacuous: the gate MLP consumes the raw
# belief vectors (incl. b_bg) and was TRAINED under the dogmatic encoding;
# evaluating it on vacuous inputs would be a train/test encoding mismatch.
#
# Precondition: eval_detector_only_{dbf,naive,abf}_vacuous_seeds.job completed.
#
# Submit with:
#   sbatch scripts/rescore_belief_metrics_vacuous.job

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
BASE=$PRETRAINED/edtc_fusion
VAL=$DATA/val
TEST=$DATA/test

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH
cd $REPO

for SEED in 0 1 2; do
    for VARIANT in abf; do
        for SPLIT in val test; do
            D=$BASE/${SPLIT}_results_detector_only_${VARIANT}_peak_vacuous_seed${SEED}
            ROOT=$VAL
            if [ "$SPLIT" = "test" ]; then ROOT=$TEST; fi
            if [ -d "$D" ]; then
                echo ""; echo "==> $D"
                srun --ntasks=1 python -u -m src.edtc_fusion.rescore_belief_metrics \
                    --results_dir "$D" --dataset_root "$ROOT"
            else
                echo "[skip] $D (missing)"
            fi
        done
    done
done

echo ""
echo "============================================================"
echo "Vacuous-encoding belief-quality rescoring complete."
echo "Compare against the dogmatic-encoding counterparts:"
echo "  val_results_detector_only_{dbf,naive}_peak[_seed{1,2}]"
echo "Expected: DBF-vacuous metrics coincide with ABF's"
echo "  (val_results_detector_only_abf_peak[_seed{1,2}])."
echo "============================================================"
