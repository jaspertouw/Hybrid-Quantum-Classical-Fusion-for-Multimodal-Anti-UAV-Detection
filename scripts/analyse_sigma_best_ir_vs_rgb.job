#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=sigma_best_ir_vs_rgb
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=00:20:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/sigma_best_ir_vs_rgb_%j.out

# Per-frame sigma2_best distributions for IR-only vs RGB-only, conditioned on
# localisation success vs failure (validation, seeds 0/1/2, mean across seeds).
#
# Reuses the per-frame *_log.csv + *.txt logs already produced by the
# eval_detector_only_{ir,rgb}[_seeds] jobs — no model reload, CPU-only workload
# (GPU partition used only for resource access; matches analyse_separability_*).
#
# Per-seed folder naming (mirrors analyse_separability_detonly_seeds.job):
#   seed 0 : val_results_detector_only_{ir,rgb}
#   seed N : val_results_detector_only_{ir,rgb}_seed${N}

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
BASE=/home/ssuttorp/pretrained_models/edtc_fusion
VAL=$DATA/val
OUT=$REPO/reports/sigma_best_ir_vs_rgb_conditioned
FIG=$REPO/outputs/sigma_best_ir_vs_rgb_conditioned.png

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH
mkdir -p $OUT $REPO/outputs $REPO/logs
cd $REPO

srun --ntasks=1 python -u scripts/analyse_sigma_best_ir_vs_rgb_conditioned.py \
    --base         "$BASE" \
    --dataset_root "$VAL" \
    --seeds        0 1 2 \
    --success_iou  0.5 \
    --out_fig      "$FIG" \
    --out_dir      "$OUT"

echo ""
echo "============================================================"
echo "Done."
echo "Figure  -> $FIG"
echo "Table   -> $OUT/sigma_best_ir_vs_rgb_report.md"
echo "JSON    -> $OUT/sigma_best_ir_vs_rgb.json"
echo "============================================================"
