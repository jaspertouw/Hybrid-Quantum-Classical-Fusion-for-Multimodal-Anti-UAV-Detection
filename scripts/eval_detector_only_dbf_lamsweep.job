#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=detonly_dbf_lamsweep
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=02:00:00
#SBATCH --array=0-4
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/detector_only_dbf_lamsweep_%A_%a.out

# Detector-only DBF lambda sweep — VAL eval stage.
# One array task per lambda in the 5-point log grid: 0.25 0.5 1.0 2.0 4.0.
# lambda reshapes the conflict-discount curve eta = (1 - C^lam)^(1/lam):
#   lam<1 = aggressive discounting, lam=1 = linear (current), lam>>1 = DBF -> ABF.
# Each task: dual YOLO + DBF belief fusion + DMS box selection on VAL, writing
# per-lambda results so calibrate/test stages can pick up *_log.csv per lambda.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

# --- lambda grid (5-point log grid centered on the current lam=1.0) ---
LAMS=(0.25 0.5 1.0 2.0 4.0)
LAM=${LAMS[$SLURM_ARRAY_TASK_ID]}
TAG=${LAM/./p}          # 0.25 -> 0p25, 1.0 -> 1p0, etc.

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
RESULTS=$PRETRAINED/edtc_fusion/val_results_detector_only_dbf_peak_lam$TAG

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH

mkdir -p $RESULTS
mkdir -p $REPO/logs

cd $REPO

echo "=== DBF lambda sweep [VAL]  lam=$LAM  tag=$TAG  array_task=$SLURM_ARRAY_TASK_ID ==="

srun python -u -m src.edtc_fusion.run_detector_only \
    --mode          dbf \
    --dataset_root  $DATA/val \
    --results_dir   $RESULTS \
    --unc_agg       peak \
    --yolo_ir       $PRETRAINED/evidential/evidential_ir_stage2_best.pt \
    --yolo_ir_base  $PRETRAINED/best_clean.pt \
    --yolo_rgb      $PRETRAINED/evidential/evidential_rgb_stage2_best.pt \
    --yolo_rgb_base $PRETRAINED/best_clean_rgb.pt \
    --fusion        dbf \
    --lam           $LAM

echo ""
echo "Detector-only DBF VAL eval complete for lam=$LAM."
echo "Per-frame logs : $RESULTS/<seq>_log.csv"
echo "Summary        : $RESULTS/summary.json"
echo "Next           : calibrate_detonly_dbf_lamsweep.job (per-lambda theta_cls sweep)"
