#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=test_rgb
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=04:00:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/test_edtc_single_rgb_%A.out

# TEST SET EVALUATION — Single-modality RGB baseline.
# Thresholds locked from validation calibration.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models

# ── Thresholds (locked from validation — do not change) ──────────────────
THETA_CLS_DETECT=0.696
THETA_LOC_DETECT=0.059
THETA_CLS_TRACK=0.100
THETA_LOC_TRACK=0.400
# ──────────────────────────────────────────────────────────────────────────

RESULTS=$PRETRAINED/edtc_fusion/test_results_single_rgb

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH

mkdir -p $RESULTS
mkdir -p $REPO/logs

cd $REPO

srun python -u -m src.edtc_fusion.run_edtc_single \
    --modality            rgb \
    --dataset_root        $DATA/test \
    --results_dir         $RESULTS \
    --yolo                $PRETRAINED/evidential/evidential_rgb_stage2_best.pt \
    --yolo_base           $PRETRAINED/best_clean_rgb.pt \
    --siam_stage2         $PRETRAINED/siamcar_gaussian/siamcar_rgb_stage2_best.pth \
    --siam_stage1         $PRETRAINED/siamcar_gaussian/siamcar_rgb_stage1g_best.pth \
    --siam_pretrained     $PRETRAINED/siamcar_rgb_final.pth \
    --siam_cfg            $REPO/resources/SiamCAR/experiments/siamcar_r50/config_antiuav_rgb.yaml \
    --theta_cls_detect    $THETA_CLS_DETECT \
    --theta_loc_detect    $THETA_LOC_DETECT \
    --theta_cls_track     $THETA_CLS_TRACK \
    --theta_loc_track     $THETA_LOC_TRACK

echo ""
echo "============================================================"
echo "  TEST SET EVALUATION COMPLETE — Single-modality RGB"
echo "  Split      : TEST"
echo "  cls_detect : $THETA_CLS_DETECT  loc_detect : $THETA_LOC_DETECT"
echo "  cls_track  : $THETA_CLS_TRACK   loc_track  : $THETA_LOC_TRACK"
echo "  Summary    : $RESULTS/summary.json"
echo "  Acc metric : failure_iou_thresh=1e-5  penalty_denom=T_total (not T*)  [matches EDTC eval script]"
echo "============================================================"
