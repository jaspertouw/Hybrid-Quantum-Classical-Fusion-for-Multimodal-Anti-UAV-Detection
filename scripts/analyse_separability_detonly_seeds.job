#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=separability_detonly_seeds
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=00:30:00
#SBATCH --array=0-1%1
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/separability_detonly_seed_%A_%a.out

# Det-only uncertainty separability — per-seed (seeds 1 and 2).
# Seed 0 is the existing analyse_separability_detonly.job run.
#
# Identical analysis to the seed-0 job (same script, same success_iou, same
# conditioned argmax(b_fused)==UAV convention) — only the input result dirs and
# the output report dir carry the seed suffix.
#
# NOTE the irregular per-seed folder naming (inherited from the eval scripts):
#   val IR/RGB drop the "_peak" tag; the fusion configs keep it. All carry
#   "_seed${SEED}". This mirrors _seed_runs() in src/edtc_fusion/print_metrics_tables.py.
#
# CPU-only workload; the GPU partition is used only for resource access.
# Prerequisite: eval_detector_only_*_seeds.job (_peak agg) runs completed for this seed.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0

source activate thesis2026

SEEDS=(1 2)
SEED=${SEEDS[$SLURM_ARRAY_TASK_ID]}

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
BASE=$PRETRAINED/edtc_fusion
VAL=$DATA/val
OUT=$REPO/reports/separability_detonly_seed${SEED}
SUCCESS_IOU=0.5          # failure := IoU < SUCCESS_IOU. Set 0.00001 to match
                         # the EDTC IoU=1e-5 localisation-failure flag.

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH
mkdir -p $OUT $REPO/logs
cd $REPO

echo "Det-only separability — seed=${SEED}"

run () {  # $1=folder (under $BASE)   $2=modality (ir|rgb|fusion)   $3=out name
    D=$BASE/$1
    if [ -d "$D" ]; then
        echo ""; echo "==> $3 ($2)  [$1]"
        srun --ntasks=1 python -u scripts/analyse_uncertainty_separability_detonly.py \
            --results_dir  "$D" \
            --dataset_root "$VAL" \
            --modality     "$2" \
            --success_iou  $SUCCESS_IOU \
            --out_dir      "$OUT/$3_val"
    else
        echo "[skip] $D (missing)"
    fi
}

#    folder                                              modality  out name
run  val_results_detector_only_ir_seed${SEED}           ir        ir
run  val_results_detector_only_rgb_seed${SEED}          rgb       rgb
run  val_results_detector_only_dbf_peak_seed${SEED}     fusion    dbf
run  val_results_detector_only_abf_peak_seed${SEED}     fusion    abf
run  val_results_detector_only_naive_peak_seed${SEED}   fusion    naive
run  val_results_detector_only_gated_peak_seed${SEED}   fusion    gated

echo ""
echo "============================================================"
echo "Det-only separability seed=${SEED} complete."
echo "Per-config results -> $OUT/<config>_val/separability_detonly.json"
echo "Histograms + ROC    -> $OUT/<config>_val/*.png"
echo "============================================================"
