#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=detector_only_dms
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=02:00:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/detector_only_dms_%A.out

# Detector-only DMS baseline — dual YOLO + DMS box selection ONLY.
# No fusion, no suppression gate: whenever either YOLO head detects, the DMS
# winner's box (lower normalised sigma^2) is emitted directly.  This isolates
# the contribution of DMS box selection alone (the variant previously mislabeled
# as "DBF" before the fusion gate was added).
# Acc is Option-B (DMS-aware): each prediction eval'd against DMS-winner GT.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
RESULTS=$PRETRAINED/edtc_fusion/val_results_detector_only_dms

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH

mkdir -p $RESULTS
mkdir -p $REPO/logs

cd $REPO

srun python -u -m src.edtc_fusion.run_detector_only \
    --mode          dms \
    --dataset_root  $DATA/val \
    --results_dir   $RESULTS \
    --yolo_ir       $PRETRAINED/evidential/evidential_ir_stage2_best.pt \
    --yolo_ir_base  $PRETRAINED/best_clean.pt \
    --yolo_rgb      $PRETRAINED/evidential/evidential_rgb_stage2_best.pt \
    --yolo_rgb_base $PRETRAINED/best_clean_rgb.pt

echo ""
echo "Detector-only DMS baseline complete."
echo "Per-sequence results : $RESULTS/<seq>.txt"
echo "Per-frame logs       : $RESULTS/<seq>_log.csv"
echo "Aggregate summary    : $RESULTS/summary.json  (incl. efficiency: params/GFLOPs/FPS)"
echo "Acc metric           : DMS-aware (Option-B) — pred eval'd against DMS-winner GT"
