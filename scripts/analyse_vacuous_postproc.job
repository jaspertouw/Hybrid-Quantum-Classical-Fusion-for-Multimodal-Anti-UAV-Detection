#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=vacuous_postproc
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=01:00:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/vacuous_postproc_%A.out

# Post-hoc analyses for the corrected missing-detection-encoding runs
# (--miss_belief vacuous), DBF + naive, seeds 0-2.  All CPU, over saved logs:
#
#   1. theta_cls sweep (val)        -> calibration_detonly_{v}_peak_vacuous_seed{S}
#   2. attribute robustness (both)  -> attribute_eval_{split}_{v}_vacuous.json
#   3. uncertainty separability(val)-> reports/separability_detonly[_seed{S}]/{v}_vacuous_val
#      + cross-seed aggregation
#
# ABF/gated/single/DMS are untouched by the encoding change — their existing
# analyses stay valid.  DBF-vacuous should reproduce ABF everywhere
# (C <= 1.1e-7 => eta = 1); these outputs double as that verification.
#
# Prerequisite: {eval,test}_detector_only_{dbf,naive}_vacuous_seeds.job done.
#
# Submit with:
#   sbatch scripts/analyse_vacuous_postproc.job

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
BASE=$PRETRAINED/edtc_fusion
SUCCESS_IOU=0.5

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH
mkdir -p $REPO/logs
cd $REPO

# ── 1. theta_cls sweep (val; exact offline replay of the gate) ────────────
echo "############################################################"
echo "# 1. theta_cls sweeps (val)"
echo "############################################################"
for VARIANT in dbf naive; do
    for SEED in 0 1 2; do
        LOG_DIR=$BASE/val_results_detector_only_${VARIANT}_peak_vacuous_seed${SEED}
        OUT_DIR=$BASE/calibration_detonly_${VARIANT}_peak_vacuous_seed${SEED}
        if [ ! -d "$LOG_DIR" ]; then echo "[skip] $LOG_DIR"; continue; fi
        mkdir -p $OUT_DIR
        echo ""; echo "==> theta sweep: ${VARIANT} seed${SEED}"
        python scripts/calibrate_detonly_threshold.py \
            --log_dir      $LOG_DIR \
            --dataset_root $DATA/val \
            --out_dir      $OUT_DIR \
            --top_k        10
    done
done

# ── 2. attribute robustness (val + test; seeds aggregated per variant) ───
echo ""
echo "############################################################"
echo "# 2. attribute robustness (val + test)"
echo "############################################################"
for VARIANT in dbf naive; do
    for SPLIT in val test; do
        DIRS=""
        for SEED in 0 1 2; do
            D=$BASE/${SPLIT}_results_detector_only_${VARIANT}_peak_vacuous_seed${SEED}
            if [ -d "$D" ]; then DIRS="$DIRS $D"; fi
        done
        if [ -z "$DIRS" ]; then echo "[skip] ${VARIANT} ${SPLIT} (no dirs)"; continue; fi
        echo ""; echo "==> attributes: ${VARIANT} ${SPLIT}"
        srun --ntasks=1 python -u -m src.edtc_fusion.rescore_attribute_metrics \
            --results_dir  $DIRS \
            --dataset_root $DATA/$SPLIT \
            --out          $BASE/attribute_eval_${SPLIT}_${VARIANT}_vacuous.json
    done
done

# ── 3. uncertainty separability (val, per seed) + aggregation ─────────────
echo ""
echo "############################################################"
echo "# 3. uncertainty separability (val)"
echo "############################################################"
for VARIANT in dbf naive; do
    for SEED in 0 1 2; do
        D=$BASE/val_results_detector_only_${VARIANT}_peak_vacuous_seed${SEED}
        if [ "$SEED" -eq 0 ]; then
            OUT=$REPO/reports/separability_detonly
        else
            OUT=$REPO/reports/separability_detonly_seed${SEED}
        fi
        if [ ! -d "$D" ]; then echo "[skip] $D"; continue; fi
        mkdir -p $OUT
        echo ""; echo "==> separability: ${VARIANT} seed${SEED}"
        srun --ntasks=1 python -u scripts/analyse_uncertainty_separability_detonly.py \
            --results_dir  "$D" \
            --dataset_root "$DATA/val" \
            --modality     fusion \
            --success_iou  $SUCCESS_IOU \
            --out_dir      "$OUT/${VARIANT}_vacuous_val"
    done
done

echo ""
echo "==> separability cross-seed aggregation (vacuous configs)"
python scripts/aggregate_separability_seeds.py \
    --reports_root $REPO/reports \
    --seeds 0 1 2 \
    --split val \
    --configs dbf_vacuous naive_vacuous

echo ""
echo "============================================================"
echo "Vacuous post-processing complete."
echo "  theta sweeps : $BASE/calibration_detonly_{dbf,naive}_peak_vacuous_seed{0,1,2}/theta_sweep.json"
echo "  attributes   : $BASE/attribute_eval_{val,test}_{dbf,naive}_vacuous.json"
echo "  separability : $REPO/reports/separability_detonly[_seed{1,2}]/{dbf,naive}_vacuous_val/"
echo "Sanity check: every DBF-vacuous number should match the existing ABF"
echo "run (calibration_detonly_abf_peak*, abf separability, ABF attribute rows)."
echo "============================================================"
