#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=test_detector_abf
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=02:00:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/test_detector_only_abf_%A.out

# TEST SET EVALUATION — Detector-only ABF baseline.
# Dual YOLO + ABF belief fusion + DMS box selection.  No SiamCAR, no switching.
# Acc is Option-B (DMS-aware): each prediction eval'd against DMS-winner GT.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
RESULTS=$PRETRAINED/edtc_fusion/test_results_detector_only_abf_peak

# Uncertainty threshold for the fusion gate.  The val sweep (calibrate_detonly_abf.job)
# found theta_cls INERT in [0.05, 0.95] under peak aggregation: u_fused is bimodal
# (~0.01 for detections, ~1.0 for non-detections), so any mid-plateau value is equivalent.
THETA_CLS=0.5

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH

mkdir -p $RESULTS
mkdir -p $REPO/logs

cd $REPO

srun python -u -m src.edtc_fusion.run_detector_only \
    --mode          dbf \
    --dataset_root  $DATA/test \
    --results_dir   $RESULTS \
    --unc_agg       peak \
    --yolo_ir       $PRETRAINED/evidential/evidential_ir_stage2_best.pt \
    --yolo_ir_base  $PRETRAINED/best_clean.pt \
    --yolo_rgb      $PRETRAINED/evidential/evidential_rgb_stage2_best.pt \
    --yolo_rgb_base $PRETRAINED/best_clean_rgb.pt \
    --fusion        abf \
    --theta_cls     $THETA_CLS

echo ""
echo "============================================================"
echo "  TEST SET EVALUATION COMPLETE — Detector-only ABF"
echo "  Split   : TEST"
echo "  Summary : $RESULTS/summary.json"
echo "  Acc     : DMS-aware (Option-B) — pred eval'd against DMS-winner GT"
echo "            failure_iou_thresh=1e-5  penalty_denom=T_total"
echo "============================================================"
