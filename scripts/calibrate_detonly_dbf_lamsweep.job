#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=00:30:00
#SBATCH --array=0-4
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/calib_detonly_dbf_lamsweep_%A_%a.out

# Detector-only DBF lambda sweep — CALIBRATION stage.
# One array task per lambda (0.25 0.5 1.0 2.0 4.0).  No GPU inference — replays
# the gate over logged values from the matching VAL eval to sweep theta_cls.
#
# Prerequisite: eval_detector_only_dbf_lamsweep.job must have produced
# *_log.csv in val_results_detector_only_dbf_peak_lam<tag> for this lambda.
#
# NOTE: at lam=1.0 the original sweep found theta_cls INERT in [0.05, 0.95]
# (u_fused bimodal).  Other lambda values reshape vacuity, so we re-sweep each
# to confirm whether that bimodality / inertness still holds before trusting
# a fixed theta_cls at test time.
#
# Grid: theta_cls = 0.05 .. 0.95 (step 0.05).

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0

source activate thesis2026

# --- lambda grid (must match eval_detector_only_dbf_lamsweep.job) ---
LAMS=(0.25 0.5 1.0 2.0 4.0)
LAM=${LAMS[$SLURM_ARRAY_TASK_ID]}
TAG=${LAM/./p}

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
LOG_DIR=$PRETRAINED/edtc_fusion/val_results_detector_only_dbf_peak_lam$TAG
OUT_DIR=$PRETRAINED/edtc_fusion/calibration_detonly_dbf_peak_lam$TAG

mkdir -p $OUT_DIR
mkdir -p $REPO/logs

cd $REPO

echo "=== DBF lambda sweep [CALIB]  lam=$LAM  tag=$TAG ==="

python scripts/calibrate_detonly_threshold.py \
    --log_dir      $LOG_DIR \
    --dataset_root $DATA/val \
    --out_dir      $OUT_DIR \
    --top_k        10

echo ""
echo "DBF det-only theta_cls sweep complete for lam=$LAM.  Best -> $OUT_DIR/theta_sweep.json"
