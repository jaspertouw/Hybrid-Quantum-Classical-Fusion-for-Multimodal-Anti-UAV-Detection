#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=edtc_eval_single
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=00:30:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/eval_single_%A.out

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
EDTC=$REPO/resources/EDTC

export PYTHONPATH=$EDTC:$EDTC/yolov5:$PYTHONPATH

cd $EDTC

MODEL=/home/ssuttorp/pretrained_models/UAVTrackEH.pth.tar

# Stage 1: run tracker on sequence 0 only (smoke test)
srun python tracking/test.py \
    --tracker_name uavtrack_eh \
    --tracker_param baseline \
    --dataset_name antiuav \
    --sequence 0 \
    --threads 8 \
    --num_gpus 1 \
    --params__model $MODEL \
    --params__search_area_scale 4.55

# Stage 2: compute Mixed Measure score from tracker results vs ground truth
srun python tracking/evaluate_antiuav_performance.py

echo "Single-sequence evaluation complete."
