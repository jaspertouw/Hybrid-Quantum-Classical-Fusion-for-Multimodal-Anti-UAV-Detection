#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=val_ir
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=04:00:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/edtc_ir_calibrated_%A.out

# VALIDATION SET — Single-modality IR threshold calibration.
# If this run beats the current best val Acc (0.6867), update the
# thresholds in eval_edtc_single_ir_calibrated.job before submitting
# the test set job.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models

# ── Thresholds under evaluation ───────────────────────────────────────────
THETA_CLS_DETECT=0.680
THETA_LOC_DETECT=0.060
THETA_CLS_TRACK=0.200
THETA_LOC_TRACK=0.500
# ──────────────────────────────────────────────────────────────────────────

TAG="cd${THETA_CLS_DETECT}_ld${THETA_LOC_DETECT}_ct${THETA_CLS_TRACK}_lt${THETA_LOC_TRACK}"
RESULTS=$PRETRAINED/edtc_fusion/val_results_single_ir_calibrated_${TAG}

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH

mkdir -p $RESULTS
mkdir -p $REPO/logs

cd $REPO

srun python -u -m src.edtc_fusion.run_edtc_single \
    --modality            ir \
    --dataset_root        $DATA/val \
    --results_dir         $RESULTS \
    --yolo                $PRETRAINED/evidential/evidential_ir_stage2_best.pt \
    --yolo_base           $PRETRAINED/best_clean.pt \
    --siam_stage2         $PRETRAINED/siamcar_gaussian/siamcar_ir_stage2_best.pth \
    --siam_stage1         $PRETRAINED/siamcar_gaussian/siamcar_ir_stage1g_best.pth \
    --siam_pretrained     $PRETRAINED/siamcar_thermal_final.pth \
    --siam_cfg            $REPO/resources/SiamCAR/experiments/siamcar_r50/config_antiuav_thermal.yaml \
    --theta_cls_detect    $THETA_CLS_DETECT \
    --theta_loc_detect    $THETA_LOC_DETECT \
    --theta_cls_track     $THETA_CLS_TRACK \
    --theta_loc_track     $THETA_LOC_TRACK

echo ""
echo "Val Acc -> $RESULTS/summary.json"
echo "Compare against current best: 0.6867 (cls_d=0.724 loc_d=0.080 cls_t=0.286 loc_t=0.614)"
echo "If improved: update eval_edtc_single_ir_calibrated.job and submit test set."
echo "Acc metric : failure_iou_thresh=1e-5  penalty_denom=T_total (not T*)  [matches EDTC eval script]"
