#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=00:30:00
#SBATCH --job-name=calib_detonly_seeds
#SBATCH --array=0-2
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/calib_detonly_seed_%A_%a.out

# Detector-only theta_cls sweep — per-seed (seeds 0, 1 and 2), all gated variants.
# Seed 0 re-runs the existing calibrate_detonly_{dbf,abf,naive,gated}.job sweeps
# (exact replay, Acc unchanged) so its theta_sweep.json also gains the
# u_fused_gate_eligible_stats / theta_inert_over_grid fields.
#
# NOTE the irregular per-seed folder naming (inherited from the eval scripts):
# seed 0 dirs carry NO "_seed0" suffix (val_results_detector_only_<v>_peak);
# seeds 1 and 2 append "_seed<S>".  Output dirs mirror this.
#
# EXACT offline replay over the logged per-frame values (no GPU inference).
# Purpose: confirm per seed whether the seed-0 finding holds that theta_cls is
# INERT in [0.05, 0.95] — on gate-eligible frames u_fused stays ~0.01, two
# orders of magnitude below the grid floor, so the vacuity check never fires
# and the gate reduces to argmax(b_fused).  The sweep output now also records
# the u_fused distribution on gate-eligible frames (theta_sweep.json:
# u_fused_gate_eligible_stats / theta_inert_over_grid).
#
# Grid: theta_cls = 0.05 .. 0.95 (step 0.05), same as the seed-0 sweeps.
# Prerequisite: the matching det-only val evals completed (seed 0:
# eval_detector_only_*.job; seeds 1/2: eval_detector_only_*_seeds.job),
# producing *_log.csv in the per-seed val_results dirs.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0

source activate thesis2026

SEEDS=(0 1 2)
SEED=${SEEDS[$SLURM_ARRAY_TASK_ID]}

# Seed 0 result/calibration dirs carry no seed suffix.
if [ "$SEED" -eq 0 ]; then SUFFIX=""; else SUFFIX="_seed${SEED}"; fi

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
BASE=$PRETRAINED/edtc_fusion

mkdir -p $REPO/logs
cd $REPO

echo "=== Det-only theta_cls sweep — seed=${SEED} ==="

for VARIANT in dbf abf naive gated; do
    LOG_DIR=$BASE/val_results_detector_only_${VARIANT}_peak${SUFFIX}
    OUT_DIR=$BASE/calibration_detonly_${VARIANT}_peak${SUFFIX}
    if [ ! -d "$LOG_DIR" ]; then
        echo "[skip] $VARIANT: $LOG_DIR missing"
        continue
    fi
    mkdir -p $OUT_DIR
    echo ""
    echo "==> $VARIANT (seed=${SEED})"
    python scripts/calibrate_detonly_threshold.py \
        --log_dir      $LOG_DIR \
        --dataset_root $DATA/val \
        --out_dir      $OUT_DIR \
        --top_k        10
done

echo ""
echo "Det-only theta_cls sweeps complete for seed=${SEED}."
echo "Results -> $BASE/calibration_detonly_<variant>_peak${SUFFIX}/theta_sweep.json"
