#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=detector_only_gated
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --time=02:00:00
#SBATCH --output=/home/ssuttorp/mm-uav-threat-detection/logs/detector_only_gated_%A.out

# Detector-only Gated Fusion baseline — dual YOLO + learned MLP gate + fusion gate + DMS.
# No SiamCAR, no switching.
# Fusion rule: b_gated = g*b_rgb + (1-g)*b_ir  where g = sigmoid(MLP(cat([b_rgb, b_ir])))
# Suppression gate: b_gated[UAV] <= b_gated[bg] -> [0,0,0,0]
# Acc is Option-B (DMS-aware): each prediction eval'd against DMS-winner GT.
# Requires a trained gate checkpoint — run train_gate.job first.

set -e

module purge
module load 2024
module load Miniconda3/24.7.1-0
module load CUDA/12.6.0

source activate thesis2026

REPO=/home/ssuttorp/mm-uav-threat-detection
DATA=/home/ssuttorp/Anti-UAV-RGBT
PRETRAINED=/home/ssuttorp/pretrained_models
RESULTS=$PRETRAINED/edtc_fusion/val_results_detector_only_gated_peak

export PYTHONPATH=$REPO:$REPO/resources/EDTC:$REPO/resources/EDTC/yolov5:$REPO/resources/SiamCAR:$PYTHONPATH

mkdir -p $RESULTS
mkdir -p $REPO/logs

cd $REPO

srun python -u -m src.edtc_fusion.run_detector_only \
    --mode          gated \
    --dataset_root  $DATA/val \
    --results_dir   $RESULTS \
    --unc_agg       peak \
    --yolo_ir       $PRETRAINED/evidential/evidential_ir_stage2_best.pt \
    --yolo_ir_base  $PRETRAINED/best_clean.pt \
    --yolo_rgb      $PRETRAINED/evidential/evidential_rgb_stage2_best.pt \
    --yolo_rgb_base $PRETRAINED/best_clean_rgb.pt \
    --gate_weights  $PRETRAINED/gated_fusion/gate_best.pth

echo ""
echo "Detector-only Gated Fusion baseline complete."
echo "Per-sequence results : $RESULTS/<seq>.txt"
echo "Per-frame logs       : $RESULTS/<seq>_log.csv  (u_fused, b_uav, sigma2_best, dms_winner)"
echo "Aggregate summary    : $RESULTS/summary.json"
echo "Acc metric           : DMS-aware (Option-B) — pred eval'd against DMS-winner GT"
echo "                       failure_iou_thresh=1e-5  penalty_denom=T_total"
